#!/bin/sh
set -eu
. /usr/local/lib/julia_ynh/runtime-permissions.sh
repair_shared_julia_runtime_permissions /var/lib/julia julia

group="julia"
getent group "$group" >/dev/null 2>&1 || groupadd --system "$group"

for user in "$@"; do
  case "$user" in
    ""|*[!a-zA-Z0-9_-]*) continue ;;
  esac
  id "$user" >/dev/null 2>&1 || continue
  usermod --append --groups "$group" "$user"
done

# Consumers manage their own depots. Never modify registries or another app's
# depot as a side effect of granting access to the Julia runtime.

exit 0
