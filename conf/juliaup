#!/bin/bash
set -eu
source /usr/local/lib/julia_ynh/runtime-permissions.sh

repair_juliaup_runtime_permissions() {
  repair_shared_julia_runtime_permissions "__INSTALL_DIR__" "__APP__"
}

if [ "$(id -u)" -eq 0 ] && [ -z "${JULIAUP_YNH_REEXEC:-}" ]; then
  repair_juliaup_runtime_permissions
  rc=0
  runuser -u "__APP__" -- env JULIAUP_YNH_REEXEC=1 "$0" "$@" || rc=$?
  repair_juliaup_runtime_permissions
  exit "$rc"
fi

cd "__INSTALL_DIR__"
export HOME="__INSTALL_DIR__"
export JULIAUP_DEPOT_PATH="__JULIAUP_DEPOT__"
export JULIA_DEPOT_PATH="__JULIAUP_DEPOT__"
export PATH="__INSTALL_DIR__/.juliaup/bin:${PATH}"

rc=0
repair_juliaup_runtime_permissions
"__JULIAUP_BIN__" "$@" || rc=$?
repair_juliaup_runtime_permissions
exit "$rc"
