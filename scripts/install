#!/bin/bash
set -eu

# shellcheck disable=SC1090
source "$(dirname "$0")/_common.sh"

ynh_script_progression "Preparing juliaup directories..."
# Ensure home exists for juliaup
mkdir -p "$install_dir"
mkdir -p "$juliaup_depot"
chown -R "$app:$app" "$install_dir"
ynh_app_setting_set --app="$app" --key=install_dir --value="$install_dir"

# If a stale juliaup config exists without a juliaup binary, clean it up
if [ ! -x "$juliaup_bin" ] && [ -f "$juliaup_depot/juliaup/juliaup.json" ]; then
  ynh_print_info "Removing stale juliaup metadata before reinstall."
  ynh_safe_rm "$juliaup_depot/juliaup/juliaup.json"
fi

ynh_script_progression "Installing juliaup..."
_run_with_permissions_repair _juliaup_install
_ensure_default_julia_channel

ynh_script_progression "Initialising the Julia runtime..."
_julia_environment_update

ynh_script_progression "Adding the shared Julia registries..."
_bootstrap_shared_registries

ynh_script_progression "Deploying Julia launchers and shared configuration..."
deploy_julia_shell_files

# Juliaup and Julia have now created their mutable files.  Only now is it safe
# to make the runtime and registry depot usable by dependent application users.
_juliaup_exec status
ensure_juliaup_permissions
